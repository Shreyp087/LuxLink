# Every VITE_ variable is embedded in the browser bundle. Never put secrets here.
VITE_APP_NAME=LuxLink
VITE_APP_ENV=development
VITE_ENABLE_DEBUG_TOOLS=false
VITE_LOG_LEVEL=info
VITE_MAX_BUNDLE_BYTES=4096

# Test runner only. This is not included in the browser bundle.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
PLAYWRIGHT_SKIP_WEBSERVER=0
